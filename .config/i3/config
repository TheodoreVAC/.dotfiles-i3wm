bindsym $mod+Mod1+Left workspace prev
bindsym $mod+Mod1+Right workspace next


exec_always --no-startup-id ~/.config/polybar/launch.sh

# Переключение раскладки клавиатуры:
# US <-> RU с помощью Alt+Shift
exec_always --no-startup-id setxkbmap -layout us,ru -option grp:alt_shift_toggle

# Управление громкостью
bindsym F2 exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym F3 exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym F4 exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Установить разрешение 1920x1080 и частоту обновления 165 Гц
# для HDMI-A-0
exec_always --no-startup-id xrandr --output HDMI-A-0 --mode 1920x1080 --rate 165

# Скриншоты (maim + slop + xclip)

# Print — выбрать область экрана и скопировать скриншот в буфер обмена
bindsym Print exec --no-startup-id maim -s - | xclip -selection clipboard -t image/png

# Mod+Print — выбрать область и сохранить скриншот в ~/Pictures
# Имя файла содержит текущую дату и время
bindsym $mod+Print exec --no-startup-id maim -s ~/Pictures/$(date +%F_%H-%M-%S).png

# Mod+Shift+Print — сделать скриншот всего экрана
# и скопировать его в буфер обмена
bindsym $mod+Shift+Print exec --no-startup-id maim | xclip -selection clipboard -t image/png

# Убираем заголовки и рамки всех окон
# в обычном (тайловом) режиме
# Рамки без заголовков

default_border pixel 0
default_floating_border pixel 2

# Отступы между окнами
 gaps inner 5
 gaps outer 5

# Цвета окон
client.focused          #1686b8 #1686b8 #06111f #1686b8 #1686b8
client.unfocused        #20345f #20345f #687895 #20345f #20345f
client.urgent           #b83232 #b83232 #e8e8e8 #b83232 #b83232

# picom
# Запуск композитора picom с указанным конфигурационным файлом
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf

