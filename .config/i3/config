bindsym $mod+Mod1+Left workspace prev
bindsym $mod+Mod1+Right workspace next

# ==========================================================
# POLYBAR
# ==========================================================

exec_always --no-startup-id ~/.config/polybar/launch.sh
bindsym $mod+F8 exec --no-startup-id polybar-msg cmd toggle
bindsym $mod+F12 exec --no-startup-id polybar-msg action "#tray.module_toggle"
bindsym $mod+F11 exec --no-startup-id polybar-msg action "#xwindow.module_toggle"


# Переключение раскладки клавиатуры:
# US <-> RU с помощью Alt+Shift
exec_always --no-startup-id setxkbmap -layout us,ru -option grp:alt_shift_toggle

# Управление громкостью
bindsym F2 exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym F3 exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym F4 exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym $mod+F10 exec --no-startup-id pavucontrol
bindsym $mod+F9 exec --no-startup-id nm-connection-editor

# Установить разрешение 1920x1080 и частоту обновления 165 Гц
# для HDMI-A-0
exec_always --no-startup-id xrandr --output HDMI-A-0 --mode 1920x1080 --rate 165

# Скриншоты (maim + slop + xclip)

# Print — весь экран: сохранить в Pictures и скопировать в буфер.
bindsym Print exec --no-startup-id maim | tee ~/Pictures/$(date +%F_%H-%M-%S).png | xclip -selection clipboard -t image/png

# Super+Print — выделенная область: сохранить в Pictures и скопировать в буфер.
bindsym $mod+Print exec --no-startup-id maim -s | tee ~/Pictures/$(date +%F_%H-%M-%S).png | xclip -selection clipboard -t image/png

# Убираем заголовки и рамки всех окон
# в обычном (тайловом) режиме
# Рамки без заголовков

default_border pixel 3
default_floating_border pixel 2
smart_borders on

# Отступы между окнами
gaps inner 5
gaps outer 5
gaps top 42

# Цвета окон

# Активное окно — голубой как активный workspace Polybar
client.focused          #89B4FA #89B4FA #1A202B #89B4FA #89B4FA

# Неактивное окно — тёмный холодный серый
client.unfocused        #454A54 #454A54 #D8DEE9 #454A54 #454A54

# Срочное окно
client.urgent           #F38BA8 #F38BA8 #FFFFFF #F38BA8 #F38BA8
# picom
# Запуск композитора picom с указанным конфигурационным файлом
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf
exec_always --no-startup-id feh --bg-fill ~/Wallpapers/default1.png

