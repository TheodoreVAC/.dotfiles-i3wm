configuration {
    show-icons: true;
    font: "AdwaitaMono Nerd Font Bold 12";
    location: 3;
    hide-scrollbar: false;
    xoffset: -14;
    yoffset: 46;
}

* {
    background-color: #1A202B;
    text-color: #D8DEE9;
}

window {
    width: 720px;
    border: 0px;
    border-radius: 16px;
    padding: 0px;
    background-color: #1A202B;
}

mainbox {
    children: [inputbar, listview];
    spacing: 12px;
    padding: 16px;
    background-color: #1A202B;
}

inputbar {
    children: [prompt, entry];
    spacing: 10px;
    padding: 4px;
    background-color: #1A202B;
}

prompt {
    padding: 8px 14px;
    border-radius: 8px;
    background-color: #89B4FA;
    text-color: #1A202B;
}

entry {
    padding: 8px 14px;
    border-radius: 8px;
    background-color: #202936;
    text-color: #D8DEE9;
    placeholder: "Найти уведомление";
}

listview {
    columns: 1;
    lines: 8;
    fixed-columns: true;
    fixed-height: false;
    dynamic: true;
    spacing: 6px;
    padding: 4px;
    scrollbar: true;
    background-color: #1A202B;
}

scrollbar {
    width: 4px;
    padding: 0px;
    border: 0px;
    handle-width: 4px;
    handle-color: #303B4D;
    background-color: transparent;
}

element {
    orientation: horizontal;
    spacing: 12px;
    padding: 10px 12px;
    border: 2px;
    border-color: transparent;
    border-radius: 10px;
    background-color: #202936;
    text-color: #D8DEE9;
}

element-icon {
    size: 28px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element selected {
    border-color: #89B4FA;
    background-color: #303B4D;
    text-color: #89B4FA;
}
