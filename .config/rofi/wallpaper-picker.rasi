configuration {
    show-icons: true;
    font: "AdwaitaMono Nerd Font Bold 12";
    location: 0;
    hide-scrollbar: false;
}

* {
    background-color: #1A202B;
    text-color: #D8DEE9;
}

window {
    width: 42%;
    height: 68%;
    border: 0px;
    border-radius: 12px;
    padding: 0px;
    background-color: #1A202B;
}

mainbox {
    children: [inputbar, listview];
    spacing: 8px;
    padding: 12px;
    background-color: #1A202B;
}

inputbar {
    children: [prompt, entry];
    spacing: 8px;
    padding: 2px;
    background-color: #1A202B;
}

prompt {
    padding: 6px 10px;
    border-radius: 6px;
    background-color: #89B4FA;
    text-color: #1A202B;
}

entry {
    padding: 6px 10px;
    background-color: #202936;
    text-color: #D8DEE9;
    placeholder: "Найти обои";
}

listview {
    columns: 1;
    lines: 7;
    layout: vertical;
    flow: vertical;
    fixed-columns: true;
    fixed-height: false;
    dynamic: true;
    spacing: 3px;
    scrollbar: true;
    background-color: #1A202B;
}

element {
    orientation: horizontal;
    spacing: 10px;
    padding: 5px 8px;
    border: 0px;
    border-radius: 7px;
    background-color: #202936;
    text-color: #D8DEE9;
}

element-icon {
    size: 88px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element selected {
    border: 0px;
    border-radius: 7px;
    background-color: #303B4D;
    text-color: #89B4FA;
}
