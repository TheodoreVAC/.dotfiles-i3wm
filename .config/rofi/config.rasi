/* Zproger's Rofi layout, recolored to match the local Polybar palette. */

* {
    bg-col:       #1A1215;
    bg-col-light: #241A1D;
    border-col:   #E63946;
    selected-col: #2E1F23;
    fg-col:       #EADCDE;
    fg-col2:      #FF5A63;
    blue:         #E63946;
    grey:         #8C7376;

    /* Override Rofi's built-in light palette used by state-specific rows. */
    background:                   #1A1215;
    foreground:                   #EADCDE;
    lightbg:                      #241A1D;
    lightfg:                      #EADCDE;
    red:                          #FF5A63;
    normal-background:            #1A1215;
    normal-foreground:            #EADCDE;
    alternate-normal-background:  #1A1215;
    alternate-normal-foreground:  #EADCDE;
    active-background:            #1A1215;
    active-foreground:            #E0A458;
    urgent-background:            #1A1215;
    urgent-foreground:            #FF5A63;
    selected-normal-background:   #2E1F23;
    selected-normal-foreground:   #FF5A63;
    selected-active-background:   #2E1F23;
    selected-active-foreground:   #FF5A63;
    selected-urgent-background:  #2E1F23;
    selected-urgent-foreground:  #FF5A63;
    alternate-active-background: #1A1215;
    alternate-active-foreground: #E0A458;
    alternate-urgent-background: #1A1215;
    alternate-urgent-foreground: #FF5A63;
}

configuration {
    modi: "drun";
    lines: 6;
    font: "AdwaitaMono Nerd Font Bold 14";
    show-icons: true;
    icon-theme: "Papirus-dark";
    terminal: "alacritty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    sidebar-mode: false;
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    width: 800px;
    height: 500px;
    border: 3px;
    border-color: @border-col;
    background-color: @bg-col;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col;
    border-radius: 2px;
    padding: 2px;
}

prompt {
    background-color: @blue;
    padding: 6px;
    text-color: @bg-col;
    border-radius: 1px;
    margin: 20px 0px 0px 20px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 6px;
    margin: 20px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col;
    placeholder: "Search";
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 10px 0px 0px 20px;
    columns: 2;
    background-color: @bg-col;
}

element {
    padding: 5px;
    background-color: @bg-col;
    text-color: @fg-col;
}

element-icon {
    size: 30px;
}

element selected {
    background-color: @selected-col;
    text-color: @fg-col2;
}

/* Rofi applies state-specific selected rules after the generic selector. */
element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @selected-col;
    text-color: @fg-col2;
    border: 0px;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 10px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: @blue;
}
