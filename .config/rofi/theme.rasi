/*
 * ROFI — DARK POLYBAR STYLE
 * Fully opaque — NO transparency
 */

* {
    background:          #1a202b;
    background-alt:      #161B24;

    foreground:          #D8DEE9;
    foreground-dim:      #6F7785;
    foreground-white:    #FFFFFF;

    blue:                #89B4FA;
    green:               #A6E3A1;
    yellow:              #F9E2AF;
    purple:              #CBA6F7;
    orange:              #FAB387;
    red:                 #F38BA8;

    spacing:             0px;
    padding:             0px;

    font: "AdwaitaMono Nerd Font Bold 12";
}


/*==========================================================
  WINDOW
==========================================================*/

window {
    width: 720px;
    height: 520px;

    location: center;
    anchor: center;

    background-color: #1a202b;

    border: 1px;
    border-color: #161B24;
    border-radius: 5px;

    padding: 20px;

    children: [ mainbox ];
}


/*==========================================================
  MAINBOX
==========================================================*/

mainbox {
    background-color: #1a202b;

    spacing: 12px;

    children: [
        inputbar,
        message,
        listview,
        mode-switcher
    ];
}


/*==========================================================
  INPUT
==========================================================*/

inputbar {
    background-color: #161B24;

    border: 0px;
    border-radius: 4px;

    padding: 11px 14px;

    spacing: 10px;

    children: [
        prompt,
        entry,
        case-indicator
    ];
}


prompt {
    background-color: #161B24;

    text-color: #89B4FA;

    font: "AdwaitaMono Nerd Font Bold 13";
}


entry {
    background-color: #161B24;

    text-color: #D8DEE9;

    placeholder: "Search applications...";
    placeholder-color: #6F7785;

    font: "AdwaitaMono Nerd Font Bold 12";
}


case-indicator {
    background-color: #161B24;

    text-color: #6F7785;
}


/*==========================================================
  MESSAGE
==========================================================*/

message {
    background-color: #1a202b;

    border: 0px;

    padding: 0px 4px;

    text-color: #6F7785;
}


textbox {
    background-color: #1a202b;

    border: 0px;

    padding: 4px;

    text-color: #6F7785;
}


/*==========================================================
  LIST
==========================================================*/

listview {
    background-color: #1a202b;

    border: 0px;

    margin: 0px;
    padding: 0px;

    spacing: 3px;

    lines: 8;
    columns: 1;

    fixed-height: true;

    scrollbar: false;
}


/*==========================================================
  ELEMENT
==========================================================*/

element {
    background-color: #1a202b;

    border: 0px;

    padding: 9px 12px;

    spacing: 12px;

    text-color: #D8DEE9;

    children: [
        element-icon,
        element-text
    ];
}


/*==========================================================
  NORMAL
==========================================================*/

element normal.normal {
    background-color: #1a202b;

    text-color: #D8DEE9;
}


element normal.urgent {
    background-color: #1a202b;

    text-color: #F38BA8;
}


element normal.active {
    background-color: #1a202b;

    text-color: #A6E3A1;
}


/*==========================================================
  SELECTED
==========================================================*/

element selected.normal {
    background-color: #202936;

    border: 0px 0px 0px 2px;
    border-color: #89B4FA;

    text-color: #D8DEE9;
}


element selected.urgent {
    background-color: #202936;

    border: 0px 0px 0px 2px;
    border-color: #F38BA8;

    text-color: #D8DEE9;
}


element selected.active {
    background-color: #202936;

    border: 0px 0px 0px 2px;
    border-color: #A6E3A1;

    text-color: #D8DEE9;
}


/*==========================================================
  ALTERNATE
==========================================================*/

element alternate.normal {
    background-color: #1a202b;

    text-color: #D8DEE9;
}


element alternate.urgent {
    background-color: #1a202b;

    text-color: #F38BA8;
}


element alternate.active {
    background-color: #1a202b;

    text-color: #A6E3A1;
}


/*==========================================================
  ELEMENT TEXT
==========================================================*/

element-text {
    background-color: #1a202b;

    text-color: #D8DEE9;

    vertical-align: 0.5;
}


/*==========================================================
  ELEMENT ICON
==========================================================*/

element-icon {
    background-color: #1a202b;

    text-color: #D8DEE9;

    size: 28px;
}


/*==========================================================
  SELECTED TEXT
==========================================================*/

element selected.normal element-text {
    background-color: #202936;

    text-color: #D8DEE9;
}


element selected.urgent element-text {
    background-color: #202936;

    text-color: #D8DEE9;
}


element selected.active element-text {
    background-color: #202936;

    text-color: #D8DEE9;
}


/*==========================================================
  SELECTED ICON
==========================================================*/

element selected.normal element-icon {
    background-color: #202936;

    text-color: #89B4FA;
}


element selected.urgent element-icon {
    background-color: #202936;

    text-color: #F38BA8;
}


element selected.active element-icon {
    background-color: #202936;

    text-color: #A6E3A1;
}


/*==========================================================
  MODE SWITCHER
==========================================================*/

mode-switcher {
    background-color: #1a202b;

    border: 0px;

    padding: 8px 0px 0px 0px;

    spacing: 6px;
}


button {
    background-color: #161B24;

    border: 0px;

    border-radius: 4px;

    padding: 7px 14px;

    text-color: #6F7785;
}


button selected {
    background-color: #89B4FA;

    text-color: #1a202b;
}


/*==========================================================
  SCROLLBAR
==========================================================*/

scrollbar {
    background-color: #161B24;

    border: 0px;

    width: 4px;
}


scrollbar handle {
    background-color: #89B4FA;

    border: 0px;

    border-radius: 2px;
}


/*==========================================================
  ERROR
==========================================================*/

error-message {
    background-color: #161B24;

    border: 0px;

    padding: 10px;

    text-color: #F38BA8;
}
