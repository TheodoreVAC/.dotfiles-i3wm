#===========================================================
#              DUNST — RED STYLE
#   Та же палитра, что у Polybar и Rofi (#1A1215 / #E63946)
#===========================================================

[global]

#==========================================================
# WINDOW
#==========================================================

follow = mouse

# Появляется под панелью Polybar справа.
origin = top-right
offset = (14, 54)

width = 360
height = (0, 320)
notification_limit = 4

corner_radius = 3
corners = all
transparency = 0

frame_width = 2
frame_color = "#E63946"

# Зазор между уведомлениями (нужен композитор, picom запущен).
gap_size = 8

separator_height = 2
separator_color = frame

padding = 12
horizontal_padding = 14
text_icon_padding = 8

#==========================================================
# PROGRESS BAR (громкость, заряд и т.п.)
#==========================================================

progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 0
progress_bar_min_width = 150
progress_bar_max_width = 316
progress_bar_corner_radius = 2
progress_bar_corners = all

indicate_hidden = true

#==========================================================
# TEXT & ICONS
#==========================================================

font = AdwaitaMono Nerd Font 10
line_height = 4
markup = full
format = "<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
ellipsize = middle
ignore_newline = false
stack_duplicates = true
hide_duplicate_count = false
show_indicators = true

icon_position = left
min_icon_size = 48
max_icon_size = 64
icon_corner_radius = 2
icon_corners = all
icon_theme = Papirus-Dark
enable_recursive_icon_lookup = true

#==========================================================
# BEHAVIOUR
#==========================================================

idle_threshold = 120
sticky_history = true
history_length = 30
always_run_script = true
ignore_dbusclose = false
browser = /usr/bin/xdg-open
title = Уведомления
class = Dunst

mouse_left_click = do_action, close_current
mouse_middle_click = close_all
mouse_right_click = close_current

#==========================================================
# URGENCY LEVELS
#==========================================================

[urgency_low]
    background = "#120C0E"
    foreground = "#8C7376"
    frame_color = "#3A2A2E"
    highlight = "#3A2A2E"
    timeout = 3

[urgency_normal]
    background = "#1A1215"
    foreground = "#EADCDE"
    frame_color = "#E63946"
    highlight = "#E63946"
    timeout = 5

[urgency_critical]
    background = "#1A1215"
    foreground = "#FFD9DB"
    frame_color = "#FF5A63"
    highlight = "#FF5A63"
    timeout = 0
